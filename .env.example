DATABASE_URL="file:../db/custom.db"

# Signal worker starts with the long-running Next server. Set 0 for UI-only/serverless hosts.
SIGNALS_ENABLED=1
# Optional dedicated persistent SQLite path; defaults to <project>/db/signals.db.
# SIGNALS_DATABASE_URL=file:/absolute/path/signals.db
# auto = Binance first, Bybit fallback; one source exchange per signal.
SIGNALS_EXCHANGE=auto
SIGNALS_PAPER_EQUITY=10000
# Require a real, fresh provider heatmap before any BUY (missing data blocks).
SIGNALS_REQUIRE_HEATMAP=0
# Optional private server-side adapter; contract in docs/signals.md.
# SIGNALS_HEATMAP_URL=https://your-provider-adapter.example/heatmap
# SIGNALS_HEATMAP_KEY=

# Optional public HTTPS origin for a separately deployed terminal-stream service.
# The Socket.IO server must accept connections at path /.
# NEXT_PUBLIC_STREAM_URL=https://your-market-stream.example.com
